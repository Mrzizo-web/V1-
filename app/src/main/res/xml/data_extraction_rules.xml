<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- SMS, tokens, PIN hashes, and config are never cloud-backed up. -->
        <exclude domain="root" path="."/>
    </cloud-backup>
    <device-transfer>
        <!-- Keep device migration explicit and user-managed. -->
        <exclude domain="root" path="."/>
    </device-transfer>
</data-extraction-rules>
